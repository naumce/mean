# night-shift. Copy to .env and fill in. .env is gitignored.

# platform (default, leave unset): watches every load a dispatcher has
# switched on (Load.agentEnabled), polling the board every 60 s. Needs
# nothing below marked "MODE=file only" — driver, dispatcher and policy all
# come from the database, per load.
# file: the original one-load run — `npm run night:start -- loads/<x>.json`.
# Needs DRIVER_PHONE, DRIVER_NAME and DISPATCHER_EMAIL below; always live
# (never shadow), since it is a real drive on a real phone.
MODE=

# Twilio: the trial number from the console is the agent's "from".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number in E.164 — or, where carriers refuse international long codes
# (North Macedonia does), an alphanumeric sender such as NIGHTSHIFT.
# MODE=platform: this is the FALLBACK sender — every trip texts from it until
# its org has bought its own number (OrgTelephony.smsSender), then it switches
# to that automatically. Every org before slice 6 buys numbers uses this one.
TWILIO_FROM_NUMBER=
# Only when TWILIO_FROM_NUMBER is letters: the number the voice call comes from.
# Verify your own phone under Phone Numbers → Verified Caller IDs and put it here.
# MODE=platform: also the fallback caller id, same rule as TWILIO_FROM_NUMBER
# above — an org's own OrgTelephony.callerId takes over once it has one.
TWILIO_CALLER_ID=

# Signs the one-click links in dispatcher emails. Any long random string.
LINK_SECRET=

# Email the agent sends from (Gmail: use an App Password, not your login).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# MODE=file only: the cast for the test.
DISPATCHER_EMAIL=
# Optional: the phone that rings with a spoken briefing after every escalation email.
# MODE=platform: only used as a fallback in file-mode-style testing; a real
# platform trip's dispatcher phone comes from its load's AgentPolicy.
DISPATCHER_PHONE=
# MODE=file only.
DRIVER_PHONE=+389
DRIVER_NAME=

# Already have these — same values as fleet-backend/.env.
MAPBOX_TOKEN=

# Optional. Set it and driver calls become real conversations (the agent asks
# follow-ups and understands free speech); typed replies are read by the model
# too. Leave it unset and the agent keeps its one-question call and keyword
# matching. Never commit a real key.
ANTHROPIC_API_KEY=
# MODE=platform only: the sheet-sync half. The worker runs fleet-backend's
# own Google Sheets sync every poll, which unseals each org's stored Google
# refresh token with SECRET_BOX_KEY, builds the OAuth client from GOOGLE_*,
# and writes a PORTAL_URL deep link into every status cell's note. Same
# values as fleet-backend/.env — copy them across, do not mint new ones (a
# different SECRET_BOX_KEY cannot open the tokens fleet-backend sealed).
SECRET_BOX_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/dispatcher/sheet/oauth/callback
PORTAL_URL=http://localhost:5173

# Must point at the SAME fleet database fleet-backend uses (the platform's
# Load/AgentPolicy/AgentCommand tables live there) — not a night-shift-only
# database. MODE=platform reads and writes through this client exclusively;
# MODE=file uses it only for the trip/event tables, as before.
DATABASE_URL=postgresql://fleet:fleet@localhost:5434/fleet

# Public URL of this worker (the Cloudflare quick tunnel prints it). The
# driver link and Twilio's webhooks are built from it.
PUBLIC_URL=
# Demo speed for a pitch: 0.2 runs the stop rule and the ladder five times faster. Leave unset on the road.
NIGHT_SHIFT_TIME_SCALE=
PORT=3010
TZ=Europe/Skopje
