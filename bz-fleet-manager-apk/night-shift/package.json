{
  "name": "night-shift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "library:compile": "tsx src/library/cli.ts",
    "night:start": "node --env-file=.env --import tsx src/live/worker.ts",
    "night:tunnel": "cloudflared tunnel --url http://localhost:3010"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "express": "^4.21.0",
    "nodemailer": "^6.9.0",
    "twilio": "^5.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
