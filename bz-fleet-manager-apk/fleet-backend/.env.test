# See .env.example for why connect_timeout/pool_timeout/socket_timeout are
# set here too (plan A5 task 7). tests/no-silent-hang.test.ts proves the
# handler-deadline layer with a short test-only HANDLER_DEADLINE_MS instead of
# actually stopping the database — that live proof is a separate, manual step.
DATABASE_URL="postgresql://fleet:fleet@localhost:5434/fleet?connect_timeout=5&pool_timeout=5&socket_timeout=10"
JWT_ACCESS_SECRET="dev-access"
JWT_REFRESH_SECRET="dev-refresh"

# any 64 hex chars; SECRET_BOX_KEY validity is what secretBox.test.ts exercises
SECRET_BOX_KEY=aa68484a95bf369cba0e60e75ff919322a0b6d99d43082887a5f7b503b04d77a

# Night Shift sheet connector (task 7): the callback route 302s here after a
# successful OAuth exchange. googleapis/googleAuth are mocked in tests, so no
# GOOGLE_CLIENT_ID/SECRET/REDIRECT_URI are needed for this test run.
PORTAL_URL=http://localhost:5173
