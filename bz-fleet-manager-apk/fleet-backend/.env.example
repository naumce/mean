# connect_timeout / pool_timeout / socket_timeout (seconds) on the Postgres
# connection string. Without them Prisma waits indefinitely on a dead
# database instead of failing: connect_timeout bounds opening a NEW
# connection, pool_timeout bounds waiting for a free slot in Prisma's own
# pool, and socket_timeout bounds a query already in flight on a connection
# that was open BEFORE the database disappeared — the case a `docker stop` on
# an already-running server actually hits, since the API is holding warm
# connections from before the container went away (neither connect_timeout
# nor pool_timeout applies to those). 5s/5s/10s survives a real network blip;
# any longer and a dispatcher has forgotten what they clicked before the API
# admits it can't reach the database. (plan A5 task 7 — unset, a stopped
# database hung a live request for 30 minutes with no response at all.)
DATABASE_URL="postgresql://fleet:fleet@localhost:5434/fleet?connect_timeout=5&pool_timeout=5&socket_timeout=10"
# JWT_ACCESS_SECRET=   # required — set a strong random secret, no default
# JWT_REFRESH_SECRET=  # required — set a strong random secret, no default
PORT=3001

# Optional. Mapbox Directions v5 for real road geometry + miles.
# CAR routing only — no bridge heights, weight limits or hazmat bans.
# ROUTER_URL (OSRM) takes precedence when both are set.
MAPBOX_TOKEN=

DEMO_MODE=true   # enables the demo date-shift endpoint. NEVER set on a real tenant.

# Night Shift sheet connector — Google OAuth app + tokens-at-rest key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/dispatcher/sheet/oauth/callback
SECRET_BOX_KEY=
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_URL=http://localhost:5173
