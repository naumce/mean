# Base URL for the Express fleet API. Defaults to http://localhost:3001/api
# when unset — see src/lib/api.ts.
VITE_API_URL=http://localhost:3001/api

# Mapbox PUBLIC token for live map tiles (starts "pk.", never "sk.").
# A secret sk.* token must never reach the browser — it can mint tokens and
# mutate tilesets. Create a public one at account.mapbox.com/access-tokens and
# restrict it by URL. Unset = the board falls back to the schematic radar.
VITE_MAPBOX_TOKEN=
